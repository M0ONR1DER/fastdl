"VertexlitGeneric"
{
	"$baseTexture" "models/weapons/c_items/merasmus_staff"
	"$bumpmap" "models/weapons/c_items/merasmus_staff_nm"
	"$lightwarptexture" "models\lightwarps\weapon_lightwarp"

	"$phong" "1"
	"$phongexponent" "5"
	"$phongboost" "10"	
	"$phongfresnelranges"	"[.3 1 8]"
	"$halflambert" "0"

	"360?$color2" "[ 0.9 0.8 0.8 ]"

	"$glowcolor" "1"
	
	"$rimlightexponent" "4"
	"$rimlightboost" "2"

	// Cloaking
	"$cloakPassEnabled" "1"
	"$sheenPassEnabled" "1"

	"$sheenmap" 		"cubemaps\cubemap_sheen001"
	"$sheenmapmask" 		"Effects\AnimatedSheen\animatedsheen0"
	"$sheenmaptint" 		"[ .4 .4 .4 ]"
	"$sheenmapmaskframe" 	"0"
	"$sheenindex" 		"0"

	"$yellow" "0"

	"Proxies"
	{
		"AnimatedWeaponSheen"
		{
			"animatedtexturevar" 		"$sheenmapmask"
			"animatedtextureframenumvar" 	"$sheenmapmaskframe"
			"animatedtextureframerate" 		"40"
		}
		"invis"
		{
		}
		"ModelGlowColor"
		{
			"resultVar" "$glowcolor"
		}
		"Add"
		{
			"srcVar1"  "$glowcolor"
			"srcVar2"  "$selfillumtintvar" 
			"resultVar" "$selfillumtint"
		}
		"Equals"
		{
			"srcVar1"  "$glowcolor"
			"resultVar" "$color2"
		}
		"YellowLevel"
		{
			"resultVar" "$yellow"
		}
		"Multiply"
		{
			"srcVar1" "$color2"
			"srcVar2" "$yellow"
			"resultVar" "$color2"
		}
	}
}

