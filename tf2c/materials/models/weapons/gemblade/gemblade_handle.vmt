"VertexLitGeneric"
{
	"$basetexture" "models/weapons/gemblade/gemblade_handle_red"
	"$bumpmap" "models/weapons/gemblade/gemblade_handle_NM"

	"$envmap" "env_cubemap"
	"$normalmapalphaenvmapmask" "1"

	"$phong" "1"
	"$phongexponent"  "20"
	"$phongboost" "1"	
	"$lightwarptexture" "models/player/pyro/pyro_lightwarp"
	"$phongfresnelranges"	"[2.5 1.5 1]"

	"$rimlight" "1"		
	"$rimlightexponent" "2"
	"$rimlightboost" "3"

	//---------------
	// Visual Effects
	//---------------
	"$glowcolor" 		"1"
	"$cloakPassEnabled" 	"1"
	"$yellow" 		"0"

	"Proxies"
	{
		"ModelGlowColor"
		{
			"resultVar" 	"$glowcolor"
		}
		"Equals"
		{
			"srcVar1"  	"$glowcolor"
			"resultVar" 	"$selfillumtint"
		}
		"Equals"
		{
			"srcVar1"  	"$glowcolor"
			"resultVar" 	"$color2"
		}
		"invis"
		{
		}
		"YellowLevel"
		{
			"resultVar" 	"$yellow"
		}
		"Multiply"
		{
			"srcVar1" 	"$color2"
			"srcVar2" 	"$yellow"
			"resultVar" 	"$color2"
		}
	}
}