"VertexLitGeneric"
{
	"$basetexture" "models/weapons/gemblade/gemblade_red"
	"$bumpmap" "models/weapons/gemblade/gemblade_NM"

	"$envmap" "effects/invuln_red"
	"$normalmapalphaenvmapmask" "1"

    "$selfillum" "1"
    "$selfillummask" "models/weapons/gemblade/gemblade_NM"

	"$phong" "1"
	"$phongexponent"  "250"
	"$phongboost" "1"	
	"$lightwarptexture" "models/player/pyro/pyro_lightwarp"
	"$phongtint" "[4 0.3 0.5]"
	"$phongfresnelranges"	"[1 1 1]"

	"$rimlight" "1"		
	"$rimlightexponent" "100"
	"$rimlightboost" "3"	

	//---------------
	// Visual Effects
	//---------------
	"$glowcolor" 		"1"
	"$cloakPassEnabled" 	"1"
	"$yellow" 		"0"

	"Proxies"
	{
		"ModelGlowColor"
		{
			"resultVar" 	"$glowcolor"
		}
		"Equals"
		{
			"srcVar1"  	"$glowcolor"
			"resultVar" 	"$selfillumtint"
		}
		"Equals"
		{
			"srcVar1"  	"$glowcolor"
			"resultVar" 	"$color2"
		}
		"invis"
		{
		}
		"YellowLevel"
		{
			"resultVar" 	"$yellow"
		}
		"Multiply"
		{
			"srcVar1" 	"$color2"
			"srcVar2" 	"$yellow"
			"resultVar" 	"$color2"
		}
		"Sine"
		{
			"resultVar" $selfillumtint
			"sinemin" .25
			"sinemax" 2.5
			"sineperiod" 5
		}
	}
}