"VertexLitGeneric"
{
	"$basetexture"	"models\workshop\weapons\c_models\c_meteorshower\c_meteorshower"

	"$bumpmap" "models\workshop\weapons\c_models\c_meteorshower\c_meteorshower_normal"

	"$envmap" env_cubemap
	"$envmaptint" "[.05 .05 .05]"

	"$phong" "1"
	"$phongexponent" "12"
	"$phongboost" "3.5"	
	"$lightwarptexture" "models\lightwarps\weapon_lightwarp"
//	"$lightwarptexture"		"models\workshop\weapons\c_models\c_meteorshower\foil_lightwarp"

	"$phongfresnelranges"	"[1 .5 .25]"
	"$halflambert" "1"

//	"$basemapalphaphongmask" "1"

	"$rimlight" "1"
	"$rimlightexponent" "4"	
	"$rimlightboost" "1"



	"360?$color2" "[ 0.5 0.5 0.5 ]"

	//---------------
	// Visual Effects
	//---------------
	"$glowcolor" 		"1"
	"$cloakPassEnabled" 	"1"
	"$yellow" 		"0"
	"$sheenPassEnabled" "1"
	"$commweapon"		"0"
	"$phongdisablehalflambert" "1"

	"$sheenmap" 		"cubemaps/cubemap_sheen001"
	"$sheenmapmask" 		"Effects/AnimatedSheen/animatedsheen0"
	"$sheenmaptint" 		"[ 1 1 1 ]"
	"$sheenmapmaskframe" 	"0"
	"$sheenindex" 		"0"

	"$commadd_phongexponent" "30"
	"$commadd_phongboost" 	"22.5"

	"Proxies"
	{
		"ModelGlowColor"
		{
			"resultVar" 	"$glowcolor"
		}
		"Equals"
		{
			"srcVar1"  	"$glowcolor"
			"resultVar" 	"$selfillumtint"
		}
		"Equals"
		{
			"srcVar1"  	"$glowcolor"
			"resultVar" 	"$color2"
		}
		"invis"
		{
		}
		"YellowLevel"
		{
			"resultVar" 	"$yellow"
		}
		"Multiply"
		{
			"srcVar1" 	"$color2"
			"srcVar2" 	"$yellow"
			"resultVar" 	"$color2"
		}
		"AnimatedWeaponSheen"
		{
			"animatedtexturevar" 		"$sheenmapmask"
			"animatedtextureframenumvar" 	"$sheenmapmaskframe"
			"animatedtextureframerate" 		"40"
		}
        "ConVarEx"
        {
            "ConVar" "tf2c_player_nohalflambert"
            "0"
            {
                "$PhongDisableHalfLambert"  "0"
            }
            "1"
            {
                "$PhongDisableHalfLambert"  "1"
            }
        }
	}
}